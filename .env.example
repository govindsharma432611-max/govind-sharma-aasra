# Aasra Web Devs — Environment Configuration Example
# Copy to .env (gitignored) and populate secrets cleanly on your server.
# NEVER commit real API keys or SMTP credentials to Git or frontend code.

# ==============================================================================
# 1. GROQ AI CHATBOT CONFIGURATION (Required for live Aasra AI Assistant)
# ==============================================================================
GROQ_API_KEY=your_groq_api_key_here

# Supported production Groq chat model (verified against GroqCloud docs)
# Options include: openai/gpt-oss-120b, llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# Optional prompt-injection safety classifier on Groq
# GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-22m

# ==============================================================================
# 2. SERVER-SIDE EMAIL & ENQUIRY DELIVERY (Configure at least one provider)
# ==============================================================================
# Recipient email address for website contact form enquiries
CONTACT_TO_EMAIL=aasra.official07@gmail.com
# Sender address / display identity used by SMTP or Resend
CONTACT_FROM_EMAIL=aasra.official07@gmail.com

# Option A: Standard SMTP (e.g., Gmail App Password, Google Workspace, Zoho, SES)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=aasra.official07@gmail.com
# SMTP_PASS=your_app_password_here

# Option B: Resend transactional email API
# RESEND_API_KEY=

# Option C: Webhook URL (e.g., Slack, Make, n8n, or CRM endpoint)
# CONTACT_WEBHOOK_URL=

# ==============================================================================
# 3. APPLICATION METADATA
# ==============================================================================
# Canonical public site URL used in structured metadata and sitemaps
# APP_URL=https://aasrawebdevs.com
